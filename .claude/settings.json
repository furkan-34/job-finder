{
  "enabledMcpjsonServers": ["playwright"],
  "permissions": {
    "allow": [
      "Bash(uv run jobfinder profile:*)",
      "Bash(uv run jobfinder source:*)",
      "Bash(uv run jobfinder search:*)",
      "Bash(uv run jobfinder fetch:*)",
      "Bash(uv run jobfinder jobs import:*)",
      "Bash(uv run jobfinder jobs dedupe --dry-run)",
      "Bash(uv run jobfinder jobs check:*)",
      "Bash(uv run jobfinder safety model)",
      "Bash(uv run jobfinder score:*)",
      "Bash(uv run jobfinder jobs approve:*)",
      "Bash(uv run jobfinder jobs list:*)",
      "Bash(uv run jobfinder cv:*)",
      "Bash(uv run jobfinder apply:*)",
      "Bash(uv run jobfinder track:*)",
      "Bash(uv run jobfinder cost:*)",
      "Bash(uv run pytest:*)",
      "mcp__claude_ai_Gmail__search_threads",
      "mcp__claude_ai_Gmail__get_thread",
      "mcp__claude_ai_Gmail__get_message",
      "mcp__Gmail__search_threads",
      "mcp__Gmail__get_thread",
      "mcp__Gmail__get_message",
      "Read(data/**)",
      "Write(data/profile/profile.json)",
      "Write(data/searches/searches.json)",
      "Write(data/score/results/**)",
      "Write(data/cv/*/*/answer.json)",
      "Write(data/track/results/**)",
      "Write(data/apply/*/*/answer.json)",
      "Write(data/apply/*/*/user-answers.json)"
    ],
    "ask": [
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Bash(git push:*)",
      "Bash(uv run jobfinder jobs dedupe)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "mcp__claude_ai_Gmail__send_message",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__forward",
      "mcp__claude_ai_Gmail__create_draft",
      "mcp__claude_ai_Gmail__update_draft",
      "mcp__claude_ai_Gmail__delete_draft",
      "mcp__claude_ai_Gmail__create_label",
      "mcp__claude_ai_Gmail__update_label",
      "mcp__claude_ai_Gmail__delete_label",
      "mcp__claude_ai_Gmail__label_message",
      "mcp__claude_ai_Gmail__label_thread",
      "mcp__claude_ai_Gmail__unlabel_message",
      "mcp__claude_ai_Gmail__unlabel_thread",
      "mcp__claude_ai_Gmail__update_message_labels",
      "mcp__claude_ai_Gmail__apply_sensitive_message_label",
      "mcp__claude_ai_Gmail__apply_sensitive_thread_label",
      "mcp__claude_ai_Gmail__mark_message_spam",
      "mcp__claude_ai_Gmail__mark_thread_spam",
      "mcp__claude_ai_Gmail__unmark_message_spam",
      "mcp__claude_ai_Gmail__unmark_thread_spam",
      "mcp__claude_ai_Gmail__trash_message",
      "mcp__claude_ai_Gmail__trash_thread",
      "mcp__claude_ai_Gmail__untrash_message",
      "mcp__claude_ai_Gmail__untrash_thread",
      "mcp__claude_ai_Gmail__create_filter",
      "mcp__Gmail__send_message",
      "mcp__Gmail__reply",
      "mcp__Gmail__forward",
      "mcp__Gmail__create_draft",
      "mcp__Gmail__update_draft",
      "mcp__Gmail__delete_draft",
      "mcp__Gmail__create_label",
      "mcp__Gmail__update_label",
      "mcp__Gmail__delete_label",
      "mcp__Gmail__label_message",
      "mcp__Gmail__label_thread",
      "mcp__Gmail__unlabel_message",
      "mcp__Gmail__unlabel_thread",
      "mcp__Gmail__update_message_labels",
      "mcp__Gmail__apply_sensitive_message_label",
      "mcp__Gmail__apply_sensitive_thread_label",
      "mcp__Gmail__mark_message_spam",
      "mcp__Gmail__mark_thread_spam",
      "mcp__Gmail__unmark_message_spam",
      "mcp__Gmail__unmark_thread_spam",
      "mcp__Gmail__trash_message",
      "mcp__Gmail__trash_thread",
      "mcp__Gmail__untrash_message",
      "mcp__Gmail__untrash_thread",
      "mcp__Gmail__create_filter"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__playwright__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run -q --project \"$CLAUDE_PROJECT_DIR\" python -m jobfinder.send",
            "timeout": 120,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "uv run -q --project \"$CLAUDE_PROJECT_DIR\" python -m jobfinder.send",
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^job-sender$",
        "hooks": [
          {
            "type": "command",
            "command": "uv run -q --project \"$CLAUDE_PROJECT_DIR\" python -m jobfinder.handoff",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^(cv-writer|cv-reviewer|job-sender|job-matcher|job-extractor|mail-reader|profile-extractor)$",
        "hooks": [
          {
            "type": "command",
            "command": "uv run -q --project \"$CLAUDE_PROJECT_DIR\" python -m jobfinder.cost",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run -q --project \"$CLAUDE_PROJECT_DIR\" python -m jobfinder.cost",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__playwright__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run -q --project \"$CLAUDE_PROJECT_DIR\" python -m jobfinder.send",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "uv run -q --project \"$CLAUDE_PROJECT_DIR\" python -m jobfinder.handoff",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
