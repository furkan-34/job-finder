{
  "actors": [
    {
      "name": "APIFY_LINKEDIN_SCRAPER",
      "label": "LinkedIn Jobs Scraper",
      "actor_id": "curious_coder/linkedin-jobs-scraper",
      "site": "linkedin",
      "cost_per_1000_results_usd": 1.0,
      "notes": "LinkedIn job search; seniority and work mode go into the keywords (AI search since August 2026). Never given personal LinkedIn cookies.",
      "input": {
        "keywords": "{keywords}",
        "location": "{location}",
        "datePosted": "{date_posted}",
        "limitPerSource": "{limit}",
        "scrapeCompany": false
      },
      "output": {
        "source_id": "id",
        "url": "link",
        "apply_url": "applyUrl",
        "title": "title",
        "company_name": "companyName",
        "company_url": "companyLinkedinUrl",
        "company_website": "companyWebsite",
        "company_size": "companyEmployeesCount",
        "location": "location",
        "work_modes": {"field": "workplaceTypes", "transform": "work_modes"},
        "employment_type": "employmentType",
        "seniority": "seniorityLevel",
        "salary": {"field": "salaryInfo", "transform": "join"},
        "description": "descriptionText",
        "posted_at": "postedAt",
        "applicants_count": "applicantsCount"
      }
    },
    {
      "name": "APIFY_REED_SCRAPER",
      "label": "Reed.co.uk Jobs Scraper",
      "actor_id": "scrapersdelight/reed-jobs-scraper",
      "site": "reed",
      "cost_per_1000_results_usd": 0.5,
      "notes": "reed.co.uk, UK jobs only: a location must be in the UK (the city is searched within 10 miles; a country-only location searches the whole UK). Work-mode words are left out of the keywords. No 'past month' date filter. Easy-apply postings have only the Reed page as apply link.",
      "input": {
        "keywords": "{keywords}",
        "location": "{city}",
        "proximity": 10,
        "datePosted": "{date_posted}",
        "maxItems": "{limit}",
        "fetchDetails": true,
        "monitorMode": false
      },
      "drop_words": [
        "remote",
        "hybrid",
        "onsite",
        "on-site"
      ],
      "date_posted_values": {
        "anyTime": "anytime",
        "past24Hours": "today",
        "pastWeek": "lastweek"
      },
      "location_countries": [
        "United Kingdom",
        "UK",
        "Great Britain",
        "England",
        "Scotland",
        "Wales",
        "Northern Ireland"
      ],
      "output": {
        "source_id": "job_id",
        "url": "job_url",
        "apply_url": ["external_url", "job_url"],
        "title": "title",
        "company_name": "recruiter_name",
        "company_url": "recruiter_profile_url",
        "location": "location",
        "work_modes": {"field": "remote_working", "transform": "work_modes"},
        "employment_type": "contract_type",
        "salary": "salary_display",
        "description": "description_text",
        "posted_at": "posted_date",
        "applicants_count": "applications"
      }
    },
    {
      "name": "APIFY_INDEED_UK_SCRAPER",
      "label": "Indeed UK Jobs Scraper",
      "actor_id": "valig/indeed-jobs-scraper",
      "site": "indeed",
      "cost_per_1000_results_usd": 0.1,
      "notes": "uk.indeed.com, UK jobs only: a location must be in the UK (the city is searched as Indeed resolves it; a country-only location searches the whole UK). Work-mode words are left out of the keywords. Date filters are 24 hours, 7 days (no 'past month'; 'any time' sends no filter). Apply links may be Indeed's own page.",
      "input": {
        "country": "uk",
        "title": "{keywords}",
        "location": "{city}",
        "limit": "{limit}",
        "datePosted": "{date_posted}"
      },
      "drop_words": ["remote", "hybrid", "onsite", "on-site"],
      "date_posted_values": {
        "anyTime": null,
        "past24Hours": "1",
        "pastWeek": "7"
      },
      "location_countries": [
        "United Kingdom",
        "UK",
        "Great Britain",
        "England",
        "Scotland",
        "Wales",
        "Northern Ireland"
      ],
      "output": {
        "source_id": "key",
        "url": ["url", "jobUrl"],
        "apply_url": ["jobUrl", "url"],
        "title": "title",
        "company_name": "employer.name",
        "company_url": "employer.companyPageUrl",
        "company_website": "employer.corporateWebsite",
        "company_size": "employer.employeesCount",
        "location": "location.city",
        "description": "description.text",
        "posted_at": ["datePublished", "dateOnIndeed"]
      }
    },
    {
      "name": "APIFY_TOTALJOBS_SCRAPER",
      "label": "Totaljobs Jobs Scraper",
      "actor_id": "valig/totaljobs-jobs-scraper",
      "site": "totaljobs",
      "cost_per_1000_results_usd": 0.4,
      "notes": "totaljobs.com, UK jobs only: a location must be in the UK (the city is searched within 10 miles; a country-only location searches the whole UK). Work-mode words are left out of the keywords. Date filters are 24 hours, 7 days (no 'past month'; 'any time' sends no filter). A new, small actor. Apply links may be Totaljobs' own page.",
      "input": {
        "keywords": "{keywords}",
        "location": "{city}",
        "radius": "10",
        "postedWithin": "{date_posted}",
        "limit": "{limit}"
      },
      "drop_words": ["remote", "hybrid", "onsite", "on-site"],
      "date_posted_values": {
        "anyTime": null,
        "past24Hours": "1",
        "pastWeek": "7"
      },
      "location_countries": [
        "United Kingdom",
        "UK",
        "Great Britain",
        "England",
        "Scotland",
        "Wales",
        "Northern Ireland"
      ],
      "output": {
        "source_id": "id",
        "url": "url",
        "apply_url": "url",
        "title": "title",
        "company_name": "company.name",
        "company_url": "company.url",
        "company_website": "company.website",
        "company_size": "company.employees",
        "location": "location",
        "employment_type": "workType",
        "salary": "salary",
        "description": {"field": "description", "transform": "html_text"},
        "posted_at": "datePosted"
      }
    },
    {
      "name": "FREEHIRE",
      "label": "freehire.me",
      "kind": "freehire",
      "actor_id": "freehire.me",
      "site": "freehire",
      "cost_per_1000_results_usd": 0,
      "notes": "Free JSON API of the freehire.me job aggregator (about 50 ATS and job boards, tech roles); no token. Searches by country: the part of the location after the last comma must be in `countries`; the city is not used. Apply links may be a job board's redirect, not the company's form.",
      "input": {
        "q": "{keywords}",
        "countries": "{country}",
        "limit": "{limit}",
        "posted_within_days": "{days}"
      },
      "drop_words": [
        "remote",
        "hybrid",
        "onsite",
        "on-site"
      ],
      "countries": {
        "turkey": "tr",
        "türkiye": "tr",
        "germany": "de",
        "netherlands": "nl",
        "united kingdom": "gb",
        "uk": "gb",
        "united states": "us",
        "usa": "us",
        "france": "fr",
        "spain": "es",
        "italy": "it",
        "poland": "pl",
        "portugal": "pt",
        "ireland": "ie",
        "sweden": "se",
        "denmark": "dk",
        "switzerland": "ch",
        "austria": "at",
        "belgium": "be",
        "canada": "ca",
        "united arab emirates": "ae"
      },
      "output": {
        "source_id": "public_slug",
        "url": "url",
        "apply_url": "url",
        "title": "title",
        "company_name": "company",
        "location": "location",
        "employment_type": "enrichment.employment_type",
        "description": "description",
        "posted_at": "posted_at"
      }
    },
