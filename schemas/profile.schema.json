{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/furkan-34/job-finder/schemas/profile.schema.json",
  "title": "Candidate profile",
  "description": "Single source of truth for the candidate. x-level: required = must be filled; recommended = asked, may be skipped (null means skipped, absent means not asked yet); optional = taken from CV if present, never asked.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "identity", "summary", "experience", "education", "skills", "work_authorization", "preferences"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "updated_at", "source_cv", "pending_confirmations"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "updated_at": { "type": "string", "format": "date" },
        "source_cv": { "type": "string", "description": "File name of the CV this profile was extracted from." },
        "pending_confirmations": {
          "type": "array",
          "description": "Fields extracted from the CV with low confidence, waiting for the candidate's confirmation.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "value", "reason"],
            "properties": {
              "path": { "type": "string", "description": "JSON Pointer, e.g. /experience/0/end" },
              "value": {},
              "reason": { "type": "string" }
            }
          }
        }
      }
    },

    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_name", "email", "location"],
      "properties": {
        "full_name": { "type": "string", "minLength": 1, "x-level": "required" },
        "email": { "type": "string", "format": "email", "x-level": "required" },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["city", "country"],
          "x-level": "required",
          "properties": {
            "city": { "type": "string", "minLength": 1 },
            "country": { "type": "string", "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2" }
          }
        },
        "phone": { "type": ["string", "null"], "x-level": "recommended" },
        "linkedin": { "type": ["string", "null"], "format": "uri", "x-level": "recommended" },
        "github": { "type": "string", "format": "uri", "x-level": "optional" },
        "portfolio": { "type": "string", "format": "uri", "x-level": "optional" }
      }
    },

    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "total_years_experience"],
      "properties": {
        "headline": { "type": "string", "minLength": 1, "x-level": "required" },
        "total_years_experience": { "type": "number", "minimum": 0, "x-level": "required" },
        "about": { "type": "string", "x-level": "optional" }
      }
    },

    "experience": {
      "type": "array",
      "minItems": 1,
      "x-level": "required",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["company", "title", "start", "end", "location", "work_mode", "technologies", "achievements"],
        "properties": {
          "company": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "start": { "$ref": "#/$defs/yearMonth" },
          "end": {
            "oneOf": [{ "$ref": "#/$defs/yearMonth" }, { "type": "null" }],
            "description": "null = current position"
          },
          "location": { "type": "string" },
          "work_mode": { "$ref": "#/$defs/workMode" },
          "technologies": { "type": "array", "items": { "type": "string" } },
          "achievements": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "One bullet per item, quantified where possible."
          }
        }
      }
    },

    "education": {
      "type": "array",
      "minItems": 1,
      "x-level": "required",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["school", "degree", "field", "start_year", "end_year"],
        "properties": {
          "school": { "type": "string" },
          "degree": { "type": "string", "description": "e.g. BSc, MSc, PhD" },
          "field": { "type": "string" },
          "start_year": { "type": "integer" },
          "end_year": { "type": ["integer", "null"], "description": "null = ongoing" },
          "gpa": { "type": "string", "x-level": "optional", "description": "As written, e.g. 3.4/4.0" }
        }
      }
    },

    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technical", "languages"],
      "x-level": "required",
      "properties": {
        "technical": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "level"],
            "properties": {
              "name": { "type": "string" },
              "level": { "enum": ["expert", "advanced", "intermediate"] }
            }
          }
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["language", "level"],
            "properties": {
              "language": { "type": "string" },
              "level": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2", "native"] }
            }
          }
        }
      }
    },

    "work_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["countries_without_sponsorship", "needs_sponsorship_elsewhere"],
      "x-level": "required",
      "properties": {
        "countries_without_sponsorship": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[A-Z]{2}$" }
        },
        "needs_sponsorship_elsewhere": { "type": "boolean" }
      }
    },

    "extras": {
      "type": "object",
      "additionalProperties": false,
      "x-level": "optional",
      "properties": {
        "certifications": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "issuer": { "type": "string" },
              "year": { "type": "integer" }
            }
          }
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "technologies": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "publications": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title"],
            "properties": {
              "title": { "type": "string" },
              "venue": { "type": "string" },
              "year": { "type": "integer" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },

    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_roles", "seniority", "locations", "employment_types", "dealbreakers"],
      "properties": {
        "target_roles": { "type": "array", "minItems": 1, "items": { "type": "string" }, "x-level": "required" },
        "seniority": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["intern", "junior", "mid", "senior", "lead", "principal"] },
          "x-level": "required"
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "x-level": "required",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["place", "work_modes"],
            "properties": {
              "place": { "type": "string", "description": "City, country, region or 'anywhere'" },
              "work_modes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/workMode" } }
            }
          }
        },
        "employment_types": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["full_time", "part_time", "contract", "freelance", "internship"] },
          "x-level": "required"
        },
        "dealbreakers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["industries", "companies", "keywords", "confirmed"],
          "x-level": "required",
          "description": "Lists may be empty, but confirmed must be true (the candidate explicitly said 'none').",
          "properties": {
            "industries": { "type": "array", "items": { "type": "string" } },
            "companies": { "type": "array", "items": { "type": "string" } },
            "keywords": { "type": "array", "items": { "type": "string" } },
            "confirmed": { "const": true, "description": "The candidate confirmed these lists are complete, even if empty" }
          }
        },
        "min_salary": {
          "x-level": "recommended",
          "description": "Soft signal for scoring, not a hard filter.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["amount", "currency", "period"],
              "properties": {
                "amount": { "type": "number", "minimum": 0 },
                "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
                "period": { "enum": ["year", "month"] },
                "gross": { "type": "boolean", "default": true }
              }
            },
            { "type": "null" }
          ]
        },
        "open_to_relocation": { "type": ["boolean", "null"], "x-level": "recommended" },
        "office_days_per_week": {
          "type": ["integer", "null"], "minimum": 0, "maximum": 5,
          "x-level": "recommended",
          "description": "Days a week the candidate can work at the office, 0 to 5 (0 = remote only). At /apply an office question asking for this many days or fewer is answered yes."
        },
        "availability": {
          "x-level": "recommended",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "notice_period_weeks": { "type": "integer", "minimum": 0 },
                "earliest_start": { "type": "string", "format": "date" }
              },
              "minProperties": 1
            },
            { "type": "null" }
          ]
        },
        "must_haves": { "type": "array", "items": { "type": "string" }, "x-level": "optional" },
        "nice_to_haves": { "type": "array", "items": { "type": "string" }, "x-level": "optional" },
        "company_sizes": {
          "type": "array",
          "items": { "enum": ["1-10", "11-50", "51-200", "201-1000", "1001-5000", "5000+"] },
          "x-level": "optional"
        },
        "preferred_industries": { "type": "array", "items": { "type": "string" }, "x-level": "optional" }
      }
    }
  },

  "$defs": {
    "yearMonth": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
    "workMode": { "enum": ["remote", "hybrid", "onsite"] }
  }
}
